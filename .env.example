# GEMINI_API_KEY: Required for Google Gemini AI API calls on the server.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional server-side provider API keys (users can also connect encrypted keys per account)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# Optional 32-byte hex/passphrase key for AES-256-GCM encryption of user provider keys
PROVIDER_ENCRYPTION_KEY=
